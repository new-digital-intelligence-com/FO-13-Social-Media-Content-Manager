# ── Web app only ────────────────────────────────────────────────────────────
# The Claude Code plugins need NONE of these: they authorize in your browser
# (or via the CLI) and use Claude itself as the model.

# Integration platform PROJECT key. Starts "ak_".
# Reveal it before copying: a masked value (ak_..**xxxx) is rejected with a 401.
COMPOSIO_API_KEY=

# Stable id for the acting user. Connected accounts are scoped per user id.
COMPOSIO_TEST_USER_ID=

# Anthropic powers the app's own agent. console.anthropic.com -> API keys
ANTHROPIC_API_KEY=

# Claude model. Haiku 4.5 is fast and cheap; claude-sonnet-5 for harder work.
ANTHROPIC_MODEL=claude-haiku-4-5

# Media hosting (Cloudinary). Platforms fetch media from a public URL, so local
# files are hosted here first. Required for an Instagram Reel cover and a
# YouTube thumbnail, which accept a URL only. cloudinary.com -> Dashboard
CLOUD_NAME=
CLOUD_API_KEY=
CLOUD_API_SECRET=

# Optional: Instagram handle verification for the Grow tab.
# Instagram's API cannot look up accounts you do not manage on an
# Instagram-Login connection, so this uses an external lookup service.
# The signature is issued for that service's own front end and is time-bound —
# expect to refresh it. Leave blank to keep suggestions unverified.
# The signature is bound to the exact ts it was issued with — reusing it with a
# fresh timestamp returns 401 — so capture the pair together and set both.
IG_LOOKUP_SIGNATURE=
IG_LOOKUP_REQUEST_TS=
IG_LOOKUP_TS=
# IG_LOOKUP_ENDPOINT=  # override only if the service changes its URL

# Web search for account discovery. Set to "off" to fall back to model recall
# (cheaper, but suggestions go stale and cannot be ranked by real reach).
# WEB_SEARCH=off
# Override only for a model that supports the newer search tool:
# WEB_SEARCH_TOOL_TYPE=web_search_20260209

# ── Zernio ──────────────────────────────────────────────────────────────────
# One API for scheduling and publishing across 16 platforms, with its own
# server-side queue, retry and analytics. Key format: "sk_" + 64 hex chars.
# zernio.com -> Settings -> API keys (shown once at creation).
ZERNIO_API_KEY=

# Profile that owns the queue slots and connected accounts.
ZERNIO_PROFILE_ID=
